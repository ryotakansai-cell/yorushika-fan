// Cloudflare Workers の設定。デプロイは cron-worker フォルダで `npm run deploy`
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yorushika-cron",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",

  // サイト本体も同じ Cloudflare アカウントの Worker なので、
  // 同じドメイン内の Worker を fetch で呼べるようにする（無いとエラー1042になる）
  "compatibility_flags": ["global_fetch_strictly_public"],

  // 外から呼べるURL（*.workers.dev）は作らない。時間で動くだけなので不要で、
  // 公開しておくと誰でも叩ける入口が1つ増えるため
  "workers_dev": false,

  // 時刻は UTC。毎時47分（src/index.ts の JOBS と対応）。
  // 配信トレンドの収集（23分・38分）と重ならない時刻にしている
  "triggers": {
    "crons": ["47 * * * *"],
  },

  // 公開してよい値だけをここに書く。CRON_SECRET は `npx wrangler secret put CRON_SECRET` で登録する
  "vars": {
    "SITE_URL": "https://yorushika.sukinote.com",
  },

  // 実行ログをダッシュボードで見られるようにする（失敗したときの原因調査用）
  "observability": {
    "enabled": true,
  },
}
